{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "https://tabaq-laya-api.vercel.app/api/chat"
    },
    {
      "source": "/api/laya-health",
      "destination": "https://tabaq-laya-api.vercel.app/api/health"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}
      ]
    }
  ]
}
